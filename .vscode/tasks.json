{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ServicePulse: Dashboard starten",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "streamlit", "run", "${workspaceFolder}/app.py", "--server.address", "127.0.0.1"],
      "options": { "cwd": "${workspaceFolder}", "env": { "PYTHONIOENCODING": "utf-8" } },
      "problemMatcher": []
    },
    {
      "label": "ServicePulse: Alle Tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "pytest", "-q"],
      "options": { "cwd": "${workspaceFolder}", "env": { "PYTHONIOENCODING": "utf-8" } },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "ServicePulse: Lokalen Datenstand pruefen",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["${workspaceFolder}/scripts/check_local.py"],
      "options": { "cwd": "${workspaceFolder}", "env": { "PYTHONIOENCODING": "utf-8" } },
      "problemMatcher": []
    },
    {
      "label": "ServicePulse: Datenbank und Qualitaetsberichte aktualisieren",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["${workspaceFolder}/scripts/build.py"],
      "options": { "cwd": "${workspaceFolder}", "env": { "PYTHONIOENCODING": "utf-8" } },
      "problemMatcher": []
    }
  ]
}
