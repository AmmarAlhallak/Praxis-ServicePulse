{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ServicePulse: Dashboard (Streamlit)",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "ServicePulse: PostgreSQL prüfen/starten",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "module": "streamlit",
      "args": ["run", "${workspaceFolder}/app.py", "--server.address", "127.0.0.1", "--server.port", "8501"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "env": { "PYTHONIOENCODING": "utf-8" },
      "justMyCode": true
    }
  ]
}
